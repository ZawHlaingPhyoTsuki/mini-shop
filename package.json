{
  "name": "mini-shop",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:generate": "bun x auth@latest generate --config src/services.ts --output prisma/auth.prisma --yes",
    "build": "vite build",
    "check": "oxlint && oxfmt --write",
    "check-types": "bun run db:generate && vite build && tsc --noEmit",
    "check:ci": "oxlint && oxfmt --check",
    "db:baseline": "bunx prisma migrate diff --from-empty --to-schema prisma --script",
    "db:diff": "bunx prisma migrate diff --from-config-datasource --to-schema prisma --script",
    "db:down": "docker compose down postgres",
    "db:generate": "bunx prisma generate",
    "db:migrate": "bunx prisma migrate deploy",
    "db:migrate:dev": "bunx prisma migrate dev",
    "db:push": "bunx prisma db push",
    "db:seed": "bunx prisma db seed",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:studio": "bunx prisma studio",
    "db:watch": "docker compose up postgres",
    "dev": "vite dev",
    "env:generate": "varlock codegen --path ./",
    "postinstall": "varlock codegen --path ./",
    "serve": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/lib-storage": "^3.1155.0",
    "@aws-sdk/s3-presigned-post": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "@base-ui/react": "^1.8.0",
    "@better-auth/core": "1.7.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.1",
    "@varlock/vite-integration": "1.5.1",
    "@vercel/functions": "^3.10.3",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "lucide-react": "^1.56.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260903-beta",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "varlock": "1.18.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "prisma": "7.10.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "web-vitals": "^6.2.3"
  },
  "packageManager": "bun@1.3.5"
}
