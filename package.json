{
  "name": "mini-shop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "serve": "vite preview",
    "check-types": "vite build && tsc --noEmit",
    "check": "oxlint && oxfmt --write",
    "env:generate": "varlock codegen --path ./",
    "postinstall": "varlock codegen --path ./",
    "auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output src/db/schema/auth.ts --yes",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/core": "1.7.7",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.1",
    "@varlock/vite-integration": "1.5.1",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "drizzle-orm": "1.0.0-rc.4",
    "lucide-react": "^1.56.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260903-beta",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "varlock": "1.18.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "1.0.0-rc.4",
    "jsdom": "^30.1.2",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^6.0.3",
    "web-vitals": "^6.2.3"
  },
  "packageManager": "bun@1.3.5"
}
