model User {
  id            String  @id
  name          String  @map("name")
  email         String  @unique @map("email")
  emailVerified Boolean @map("email_verified")
  image         String? @map("image")

  sessions Session[]
  accounts Account[]

  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  // --- Business Relations --- //
  assets Asset[]
  shops  Shop[]

  @@map("user")
}

model Session {
  id        String  @id
  user      User    @relation(fields: [userId], references: [id])
  userId    String  @map("user_id")
  token     String  @unique @map("token")
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([userId], map: "session_userId_idx")
  @@map("session")
}

model Account {
  id                    String    @id
  user                  User      @relation(fields: [userId], references: [id])
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?   @map("scope")
  idToken               String?   @map("id_token")
  password              String?   @map("password")

  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model Verification {
  id         String @id
  identifier String @unique @map("identifier")
  value      String @map("value")

  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}
