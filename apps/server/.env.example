# Copy to `.env` and fill in real values for local development.
# AWS_* and BETTER_AUTH_SECRET below are shape-valid dummies so validation
# passes out of the box (CI, Docker builds); replace them with real values.
NODE_ENV=development
BETTER_AUTH_SECRET=local-dev-only-dummy-secret-0000000000000000
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001,http://localhost:3000
ADMIN_EMAIL=admin@example.com
DATABASE_URL=postgresql://postgres:password@localhost:5432/tcl-guide

# Neon Object Storage — refresh with: neon env pull --file apps/server/.env
AWS_ENDPOINT_URL_S3=https://storage.ci.invalid
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=ci-stub
AWS_SECRET_ACCESS_KEY=ci-stub
NEON_BUCKET_NAME=tcl-guide-images
