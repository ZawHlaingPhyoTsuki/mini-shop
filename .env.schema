# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# Direct (non-pooled) Neon connection string - required for migrations.
# @type=string(minLength=1)
DATABASE_URL_UNPOOLED=

# Neon Object Storage (S3-compatible) credentials for the linked branch.
# The access key id is part of every presigned upload URL we hand to the
# browser, so it must not block responses. The secret key below still does.
# @sensitive={preventLeaks=false} @type=string(minLength=1)
AWS_ACCESS_KEY_ID=

# @type=string(minLength=1)
AWS_SECRET_ACCESS_KEY=

# Not secret: the branch endpoint and region are public identifiers. Marking
# them non-sensitive also stops the leak scanner from flagging the values when
# they appear in ordinary response bodies (e.g. "us-east-2" in a client bundle).
# @sensitive=false @type=url
AWS_ENDPOINT_URL_S3=

# @sensitive=false @type=string(minLength=1)
AWS_REGION=

# @sensitive=false @type=string(minLength=1)
NEON_BUCKET_NAME=assets

# @required=false @sensitive=false @type=string(minLength=1)
NEON_BRANCH=

# Set to 1 to allow seeding the production branch. Off by default.
# @required=false @sensitive=false @type=string(minLength=1)
SEED_ALLOW_PRODUCTION=

# Local Postgres used as the Prisma shadow database for `migrate dev`.
# @required=false @sensitive=false @type=string(minLength=1)
SHADOW_DATABASE_URL=
